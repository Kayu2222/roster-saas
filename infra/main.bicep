// Roster SaaS on Azure: everything the app needs, in one resource group.
//
//   GitHub Actions --(OIDC, no stored password)--> deploy identity
//        builds image --> Container Registry --> Container App (HTTPS, scales to zero)
//                                                  |-- encrypted app secrets (copies of Key Vault values)
//                                                  '-- talks to PostgreSQL Flexible Server
//
// Sizes are pinned to the cheapest options covered by Azure for Students.
// Deploy with infra/setup.ps1 (it runs this file twice: infra first, then the app).

targetScope = 'resourceGroup'

@description('Azure region. Must be one your subscription allows.')
param location string = resourceGroup().location

@description('Short name used in every resource name.')
param appName string = 'roster'

@description('GitHub repository allowed to deploy, as owner/name.')
param githubRepo string = 'Kayu2222/roster-saas'

@description('PostgreSQL admin password. Generated by setup.ps1, stored only in Key Vault.')
@secure()
param postgresAdminPassword string

@description('Secret used to sign login tokens. Generated by setup.ps1, stored only in Key Vault.')
@secure()
param jwtSecret string

@description('False on the first run (no image pushed yet), true once an image exists.')
param deployApp bool = false

@description('Full image reference, e.g. myregistry.azurecr.io/roster-saas:<tag>.')
param containerImage string = ''

var suffix = uniqueString(resourceGroup().id)
var postgresAdminUser = 'rosteradmin'
var databaseName = 'roster'
var databaseUrl = 'postgresql+psycopg://${postgresAdminUser}:${uriComponent(postgresAdminPassword)}@${postgres.properties.fullyQualifiedDomainName}:5432/${databaseName}?sslmode=require'

// Built-in Azure role IDs (same in every tenant).
var roles = {
  acrPull: '7f951dda-4ed3-4680-a7ca-43fe172d538d'
  acrPush: '8311e382-0749-4cb8-b61a-304f252e45ec'
  contributor: 'b24988ac-6180-42a0-ab88-20f7382dd24c'
}

// ---------------------------------------------------------------------------
// Logs (first 5 GB/month free; capped low so it can't run up a bill)
// ---------------------------------------------------------------------------
resource logs 'Microsoft.OperationalInsights/workspaces@2023-09-01' = {
  name: 'log-${appName}-${suffix}'
  location: location
  properties: {
    sku: { name: 'PerGB2018' }
    retentionInDays: 30
    workspaceCapping: { dailyQuotaGb: json('0.1') }
  }
}

// ---------------------------------------------------------------------------
// Identities: one for the running app, one for GitHub Actions deployments
// ---------------------------------------------------------------------------
resource appIdentity 'Microsoft.ManagedIdentity/userAssignedIdentities@2023-01-31' = {
  name: 'id-${appName}-app'
  location: location
}

resource deployIdentity 'Microsoft.ManagedIdentity/userAssignedIdentities@2023-01-31' = {
  name: 'id-${appName}-github'
  location: location
}

// Trust GitHub's OIDC tokens, but only for pushes to main of this one repository.
resource githubTrust 'Microsoft.ManagedIdentity/userAssignedIdentities/federatedIdentityCredentials@2023-01-31' = {
  parent: deployIdentity
  name: 'github-main'
  properties: {
    issuer: 'https://token.actions.githubusercontent.com'
    subject: 'repo:${githubRepo}:ref:refs/heads/main'
    audiences: ['api://AzureADTokenExchange']
  }
}

// ---------------------------------------------------------------------------
// Container Registry (Standard is free for 12 months on Azure for Students)
// ---------------------------------------------------------------------------
resource registry 'Microsoft.ContainerRegistry/registries@2023-07-01' = {
  name: '${appName}${suffix}'
  location: location
  sku: { name: 'Standard' }
  properties: {
    adminUserEnabled: false // access only through Azure roles, never a shared password
  }
}

resource appCanPull 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  scope: registry
  name: guid(registry.id, appIdentity.id, roles.acrPull)
  properties: {
    principalId: appIdentity.properties.principalId
    principalType: 'ServicePrincipal'
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', roles.acrPull)
  }
}

resource githubCanPush 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  scope: registry
  name: guid(registry.id, deployIdentity.id, roles.acrPush)
  properties: {
    principalId: deployIdentity.properties.principalId
    principalType: 'ServicePrincipal'
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', roles.acrPush)
  }
}

// GitHub may update resources in THIS resource group only, nothing else in the subscription.
resource githubCanDeploy 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(resourceGroup().id, deployIdentity.id, roles.contributor)
  properties: {
    principalId: deployIdentity.properties.principalId
    principalType: 'ServicePrincipal'
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', roles.contributor)
  }
}

// ---------------------------------------------------------------------------
// PostgreSQL (B1ms Burstable, 32 GB: the size covered by Azure for Students)
// ---------------------------------------------------------------------------
resource postgres 'Microsoft.DBforPostgreSQL/flexibleServers@2024-08-01' = {
  name: 'pg-${appName}-${suffix}'
  location: location
  sku: {
    name: 'Standard_B1ms'
    tier: 'Burstable'
  }
  properties: {
    version: '16'
    administratorLogin: postgresAdminUser
    administratorLoginPassword: postgresAdminPassword
    storage: {
      storageSizeGB: 32
      autoGrow: 'Disabled'
    }
    backup: {
      backupRetentionDays: 7
      geoRedundantBackup: 'Disabled'
    }
    highAvailability: { mode: 'Disabled' }
    network: { publicNetworkAccess: 'Enabled' }
  }
}

// The exclusion constraints in migration 0002 need this extension; Azure requires allow-listing it first.
resource allowBtreeGist 'Microsoft.DBforPostgreSQL/flexibleServers/configurations@2024-08-01' = {
  parent: postgres
  name: 'azure.extensions'
  properties: {
    value: 'BTREE_GIST'
    source: 'user-override'
  }
}

resource database 'Microsoft.DBforPostgreSQL/flexibleServers/databases@2024-08-01' = {
  parent: postgres
  name: databaseName
  dependsOn: [allowBtreeGist] // Azure applies server changes one at a time
}

// Lets Azure-hosted services (the Container App) reach the database. Connections still need the
// password and TLS. Trade-off: cheaper and simpler than a private VNet; see README.
resource allowAzureServices 'Microsoft.DBforPostgreSQL/flexibleServers/firewallRules@2024-08-01' = {
  parent: postgres
  name: 'AllowAzureServices'
  properties: {
    startIpAddress: '0.0.0.0'
    endIpAddress: '0.0.0.0'
  }
  dependsOn: [database]
}

// ---------------------------------------------------------------------------
// Key Vault: system of record for the secrets (rotate here, then re-run setup.ps1)
// ---------------------------------------------------------------------------
resource vault 'Microsoft.KeyVault/vaults@2023-07-01' = {
  name: 'kv-${appName}-${take(suffix, 10)}'
  location: location
  properties: {
    tenantId: subscription().tenantId
    sku: { family: 'A', name: 'standard' }
    enableRbacAuthorization: true
    softDeleteRetentionInDays: 7
  }
}

resource databaseUrlSecret 'Microsoft.KeyVault/vaults/secrets@2023-07-01' = {
  parent: vault
  name: 'database-url'
  properties: {
    value: databaseUrl
  }
}

resource jwtSecretSecret 'Microsoft.KeyVault/vaults/secrets@2023-07-01' = {
  parent: vault
  name: 'jwt-secret'
  properties: {
    value: jwtSecret
  }
}

// ---------------------------------------------------------------------------
// Container Apps (Consumption profile: monthly free grant, scales to zero when idle)
// ---------------------------------------------------------------------------
resource environment 'Microsoft.App/managedEnvironments@2024-03-01' = {
  name: 'cae-${appName}'
  location: location
  properties: {
    // Declaring the serverless Consumption profile makes this a full (workload profiles) environment.
    // Without it, Azure may create an 'express' environment, which cannot read secrets from Key Vault.
    workloadProfiles: [
      {
        name: 'Consumption'
        workloadProfileType: 'Consumption'
      }
    ]
    appLogsConfiguration: {
      destination: 'log-analytics'
      logAnalyticsConfiguration: {
        customerId: logs.properties.customerId
        sharedKey: logs.listKeys().primarySharedKey
      }
    }
  }
}

resource app 'Microsoft.App/containerApps@2024-03-01' = if (deployApp) {
  name: 'ca-${appName}-api'
  location: location
  identity: {
    type: 'UserAssigned'
    userAssignedIdentities: { '${appIdentity.id}': {} }
  }
  properties: {
    managedEnvironmentId: environment.id
    workloadProfileName: 'Consumption'
    configuration: {
      activeRevisionsMode: 'Single'
      ingress: {
        external: true
        targetPort: 8000
        transport: 'auto'
        allowInsecure: false // HTTPS only
      }
      registries: [
        {
          server: registry.properties.loginServer
          identity: appIdentity.id
        }
      ]
      // Stored encrypted by Container Apps and set at deploy time. (Key Vault references would be
      // nicer, but this region runs Container Apps 'express' environments, which don't support them.)
      secrets: [
        { name: 'database-url', value: databaseUrl }
        { name: 'jwt-secret', value: jwtSecret }
      ]
    }
    template: {
      containers: [
        {
          name: 'api'
          image: containerImage
          resources: {
            cpu: json('0.25')
            memory: '0.5Gi'
          }
          env: [
            { name: 'DATABASE_URL', secretRef: 'database-url' }
            { name: 'JWT_SECRET', secretRef: 'jwt-secret' }
          ]
          probes: [
            {
              type: 'Startup'
              httpGet: { path: '/health', port: 8000 }
              initialDelaySeconds: 5
              periodSeconds: 5
              failureThreshold: 24 // up to 2 minutes for migrations + first start
            }
            {
              type: 'Liveness'
              httpGet: { path: '/health', port: 8000 }
              periodSeconds: 30
            }
          ]
        }
      ]
      scale: {
        minReplicas: 0 // no traffic, no cost (first request after idle takes a few seconds)
        maxReplicas: 1 // one replica keeps start-up migrations simple; raise later
      }
    }
  }
  dependsOn: [appCanPull, allowAzureServices, databaseUrlSecret, jwtSecretSecret]
}

// ---------------------------------------------------------------------------
// Outputs used by setup.ps1 and GitHub Actions (identifiers only, no secrets)
// ---------------------------------------------------------------------------
output registryName string = registry.name
output registryLoginServer string = registry.properties.loginServer
output containerAppName string = deployApp ? app.name : ''
output appUrl string = deployApp ? 'https://${app!.properties.configuration.ingress.fqdn}' : ''
output githubClientId string = deployIdentity.properties.clientId
output tenantId string = subscription().tenantId
output subscriptionId string = subscription().subscriptionId
output keyVaultName string = vault.name
